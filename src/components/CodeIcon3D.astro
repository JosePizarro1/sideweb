---
// Extrusión "falsa" en CSS puro: apilamos N capas del glifo <> en distintas
// profundidades (translateZ) e interpolamos su color de atrás (oscuro) hacia
// adelante (acento brillante). El padre rota como un solo objeto sólido.
const LAYERS = 10;

function hexToRgb(hex: string) {
  const n = parseInt(hex.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}

function mix(a: number[], b: number[], t: number) {
  return a.map((v, i) => Math.round(v + (b[i] - v) * t));
}

const back = hexToRgb('#e0f7fa');
const front = hexToRgb('#0891b2');

const layers = Array.from({ length: LAYERS }, (_, i) => {
  const t = i / (LAYERS - 1);
  const [r, g, b] = mix(back, front, t);
  return {
    z: i * 4,
    color: `rgb(${r} ${g} ${b})`,
  };
});
---

<div class="code3d-card">
  <div class="code3d-scene">
    <div class="code3d-cube" id="code3d">
      {layers.map((layer) => (
        <span
          class="code3d-layer"
          style={`transform: translateZ(${layer.z}px); color: ${layer.color};`}
        >
          &lt;/&gt;
        </span>
      ))}
      <span class="code3d-layer code3d-front" style={`transform: translateZ(${LAYERS * 4}px);`}>
        &lt;/&gt;
      </span>
    </div>
  </div>
</div>

<style>
  .code3d-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
    padding: 1.1rem;
    border-radius: 1.25rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 12px 28px rgba(15, 23, 42, 0.08);
  }

  .code3d-scene {
    position: relative;
    width: clamp(96px, 12vw, 128px);
    height: clamp(96px, 12vw, 128px);
    perspective: 700px;
  }

  .code3d-cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .code3d-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .code3d-front {
    color: #0e7490;
    filter: drop-shadow(0 2px 6px rgba(14, 116, 144, 0.25));
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('.code3d-scene');
  const cube = document.querySelector<HTMLElement>('#code3d');

  if (scene && cube) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    let targetRx = 0;
    let targetRy = 0;
    let rx = 0;
    let ry = 0;
    let raf = 0;
    const start = performance.now();

    const onPointerMove = (e: PointerEvent) => {
      const rect = scene.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width - 0.5;
      const py = (e.clientY - rect.top) / rect.height - 0.5;
      const max = 22;
      targetRy = px * max;
      targetRx = -py * max;
    };

    const onPointerLeave = () => {
      targetRx = 0;
      targetRy = 0;
    };

    const tick = (now: number) => {
      rx += (targetRx - rx) * 0.08;
      ry += (targetRy - ry) * 0.08;

      const float = prefersReducedMotion
        ? 0
        : Math.sin((now - start) / 1400) * 6;

      cube.style.transform = `translateY(${float}px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      raf = requestAnimationFrame(tick);
    };

    scene.addEventListener('pointermove', onPointerMove);
    scene.addEventListener('pointerleave', onPointerLeave);
    raf = requestAnimationFrame(tick);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(tick);
    });
  }
</script>
