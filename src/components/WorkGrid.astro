---
export interface WorkItem {
  id: string;
  image: string;
  title: string;
  description?: string;
  href?: string;
  isLive?: boolean;
}

interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item) => {
    const isLink = Boolean(item.href);
    return isLink ? (
      <a
        href={item.href}
        data-reveal
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 opacity-0 translate-y-4 transition-all duration-300 hover:border-slate-400 hover:shadow-lg hover:shadow-slate-200/50"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
          <img
            src={item.image}
            alt={item.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-600/90 backdrop-blur-md px-3 py-1 text-[11px] font-medium text-white shadow-sm">
            <span class="size-1.5 rounded-full bg-white animate-pulse"></span>
            Demo interactivo
          </span>
        </div>

        <div class="flex flex-1 flex-col justify-between p-5">
          <div>
            <h3 class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-cyan-700 transition-colors">
              {item.title}
            </h3>
            {item.description && (
              <p class="mt-1.5 text-xs text-slate-600 line-clamp-2 leading-relaxed">
                {item.description}
              </p>
            )}
          </div>

          <div class="mt-4 pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs font-semibold text-cyan-700 group-hover:text-cyan-800">
            <span>Ver demo en vivo</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 transform transition-transform group-hover:translate-x-1">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </a>
    ) : (
      <div
        data-reveal
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 opacity-0 translate-y-4 transition-all duration-300 hover:border-slate-300 hover:shadow-md"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
          <img
            src={item.image}
            alt={item.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>

        <div class="p-4">
          <h3 class="text-sm font-semibold text-slate-800">
            {item.title}
          </h3>
        </div>
      </div>
    );
  })}
</div>
