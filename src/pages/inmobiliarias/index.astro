---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Soluciones Digitales para Inmobiliarias · Web, Master Plan, 360° y CRM</title>
    <meta name="description" content="Páginas web inmobiliarias, master plans interactivos, recorridos 360° y CRM de leads para diferenciar proyectos y fortalecer su proceso comercial." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Soluciones Digitales para Inmobiliarias · Jose Pizarro" />
    <meta property="og:description" content="Web, Master Plan interactivo, experiencias 360° y CRM de leads conectados para vender mejor cada proyecto." />
    <meta property="og:image" content="/inmobiliarias/hero/hero-residencial-v2.jpg" />
  </head>
  <body class="inmo-clean-theme arch-grid-bg">
    <main>
      <!-- Hero editorial con imagen propia -->
      <section class="clean-hero" id="experiencias">
        <img class="hero-visual" src="/inmobiliarias/hero/hero-residencial-v2.jpg" alt="Interior contemporáneo de un proyecto residencial frente a la ciudad" width="1792" height="1024" loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-shell">
          <div class="hero-brand"><strong>José Pizarro</strong><span>Asesor tecnológico</span></div>
          <div class="hero-editorial-copy">
            <h1 class="inmo-display">Tecnología que<br/><em>vende proyectos.</em></h1>
            <p>Web inmobiliaria, master plans, experiencias 360° y CRM conectados.</p>
            <div class="hero-editorial-actions">
              <a href="#masterplan">Explorar soluciones <ArrowRight size={17} /></a>
              <a href={`${waLink}?text=${encodeURIComponent('Hola Jose, vi tus soluciones digitales para inmobiliarias y quiero conversar sobre mi proyecto.')}`} target="_blank" rel="noopener noreferrer"><IconBrandWhatsapp size={18} /> Conversemos</a>
            </div>
          </div>
        </div>
      </section>

      <section class="portfolio-showcase" aria-labelledby="portfolio-showcase-title">
        <div class="portfolio-showcase-head">
          <span class="clean-kicker">EXPERIENCIA APLICADA</span>
          <h2 class="inmo-display" id="portfolio-showcase-title">Proyectos web que ya están en línea.</h2>
          <p>Diseño, presencia digital y captación pensados para presentar cada desarrollo con mayor claridad.</p>
        </div>
        <div class="showcase-carousel" aria-label="Proyectos web inmobiliarios realizados">
          <div class="showcase-track" id="showcase-track">
            {webProjects.map((project, index) => (
              <article class:list={["showcase-slide", { active: index === 0 }]} data-showcase-slide aria-hidden={index === 0 ? 'false' : 'true'}>
                <img src={project.image} alt={`Vista del proyecto web ${project.name}`} loading="lazy" width="1600" height="900" />
                <div class="showcase-shade"></div>
                <div class="showcase-project"><i style={`--project-accent:${project.accent}`}></i>{project.name} <span>{project.type}</span></div>
              </article>
            ))}
          </div>
          <div class="showcase-controls">
            <div class="showcase-dots" role="tablist" aria-label="Seleccionar proyecto">
              {webProjects.map((project, index) => (
                <button class:list={["showcase-dot", { active: index === 0 }]} data-showcase-dot={index} type="button" aria-label={`Mostrar ${project.name}`}></button>
              ))}
            </div>
            <div class="showcase-arrows">
              <button type="button" id="showcase-prev" aria-label="Proyecto anterior"><ChevronLeft size={20} /></button>
              <button type="button" id="showcase-next" aria-label="Proyecto siguiente"><ChevronRight size={20} /></button>
            </div>
          </div>
        </div>
      </section>

      <!-- VALOR ESTRATÉGICO & ACOMPAÑAMIENTO TECNOLÓGICO -->
      <section class="value-section" aria-labelledby="value-title">
        <div class="value-panel">
          <div class="value-heading">
            <div>
              <span class="value-kicker-badge inmo-mono">
                <ShieldCheck size={14} /> ECOSISTEMA INTEGRAL DE VENTAS
              </span>
              <h2 class="inmo-display" id="value-title">Una experiencia digital que trabaja con tu equipo comercial.</h2>
              <p>Presentación visual, exploración interactiva y captura de prospectos en un solo flujo continuo.</p>
            </div>

            <div class="value-advisor-card">
              <div class="value-advisor-avatar">
                <Users size={18} />
              </div>
              <div class="value-advisor-text">
                <strong>Partner tecnológico continuo</strong>
                <p>Acompañamos a tu gerencia y equipo comercial de punta a punta.</p>
              </div>
            </div>
          </div>

          <div class="value-grid">
            <article class="value-card-item">
              <div>
                <div class="value-card-top">
                  <span class="value-icon is-green"><TrendingUp size={20} /></span>
                  <span class="value-tag inmo-mono">CAPTACIÓN</span>
                </div>
                <h3>Más prospectos</h3>
                <p>Convierte campañas de Meta, web y WhatsApp en oportunidades ordenadas al instante.</p>
              </div>
              <div class="value-card-feature">
                <Check size={13} /> <span>Trazabilidad en tiempo real</span>
              </div>
            </article>

            <article class="value-card-item">
              <div>
                <div class="value-card-top">
                  <span class="value-icon is-amber"><Sparkles size={20} /></span>
                  <span class="value-tag inmo-mono">PERCEPCIÓN</span>
                </div>
                <h3>Marca de alto valor</h3>
                <p>Recorridos 360° y visuales de alta gama que transmiten solvencia y aceleran cierres.</p>
              </div>
              <div class="value-card-feature">
                <Check size={13} /> <span>Mayor confianza de compra</span>
              </div>
            </article>

            <article class="value-card-item">
              <div>
                <div class="value-card-top">
                  <span class="value-icon is-blue"><Workflow size={20} /></span>
                  <span class="value-tag inmo-mono">OPERACIÓN</span>
                </div>
                <h3>Control total</h3>
                <p>Inventario de lotes, asesores y CRM sincronizados sin demoras ni ventas cruzadas.</p>
              </div>
              <div class="value-card-feature">
                <Check size={13} /> <span>Cero oportunidades frías</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- BARRA DE TRANSICIÓN & NAVEGACIÓN DEL ECOSISTEMA -->
      <div class="ecosystem-divider-bar">
        <div class="ecosystem-divider-inner">
          <div class="divider-kicker-wrap">
            <span class="divider-pulse"></span>
            <span class="divider-kicker inmo-mono">HERRAMIENTAS OPERATIVAS DEL DESARROLLO</span>
          </div>
          <div class="divider-nav-pills inmo-mono">
            <a href="#masterplan" class="divider-pill">
              <span class="pill-num">01</span>
              <div class="pill-text">
                <strong>Master Plan Activo</strong>
                <small>Disponibilidad y lotificación</small>
              </div>
              <ArrowRight size={14} />
            </a>
            <a href="#visor360" class="divider-pill">
              <span class="pill-num">02</span>
              <div class="pill-text">
                <strong>Recorridos 360°</strong>
                <small>Visor espacial inmersivo</small>
              </div>
              <ArrowRight size={14} />
            </a>
            <a href="#crm" class="divider-pill">
              <span class="pill-num">03</span>
              <div class="pill-text">
                <strong>CRM Inmobiliario</strong>
                <small>Consola de oportunidades</small>
              </div>
              <ArrowRight size={14} />
            </a>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 01: MASTER PLAN INTERACTIVO -->
      <section class="clean-section" id="masterplan">
        <div class="clean-section-head">
          <span class="clean-kicker">DEL PLANO A LA DECISIÓN DE COMPRA</span>
          <h2 class="clean-section-title inmo-display">Convierte un plano estático en una herramienta activa de ventas.</h2>
          <p class="clean-section-sub">
            Tus compradores pueden explorar la lotificación, comparar ubicaciones y consultar disponibilidad. Tu equipo obtiene una forma más clara de presentar el proyecto y conducir cada consulta hacia una oportunidad real.
          </p>
        </div>

        <div class="mp-console">
          <div class="mp-col-main">
            <!-- Visor del Plano -->
            <div class="mp-stage">
              <div class="mp-hud-top">
                <div class="mp-status-pills inmo-mono">
                  <div class="mp-pill"><span class="pill-dot green"></span> Disponibles (48)</div>
                  <div class="mp-pill"><span class="pill-dot amber"></span> Reservados (12)</div>
                  <div class="mp-pill"><span class="pill-dot gray"></span> Vendidos (24)</div>
                </div>

                <div class="mp-tools">
                  <button class="mp-tool-btn" id="btn-zoom-in" title="Acercar plano"><Plus size={16} /></button>
                  <button class="mp-tool-btn" id="btn-zoom-out" title="Alejar plano"><Minus size={16} /></button>
                  <button class="mp-tool-btn" id="btn-zoom-reset" title="Restablecer"><RotateCcw size={14} /></button>
                </div>
              </div>

              <div class="mp-viewport" id="mp-viewport">
                <img src="/inmobiliarias/masterplan-realista-v2.jpg" alt="Master plan de una urbanización residencial de lotes" class="mp-image" id="mp-image" />

                <svg class="mp-svg" viewBox="0 0 1000 562" preserveAspectRatio="none">
                  <polygon points="257,105 289,108 286,187 254,184" class="mp-lot-poly is-selected" data-lot-id="A-14" />
                  <text x="272" y="149" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">A14</text>

                  <polygon points="435,128 471,132 467,218 431,214" class="mp-lot-poly is-reserved" data-lot-id="B-08" />
                  <text x="451" y="176" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">B08</text>

                  <polygon points="618,152 653,156 649,239 614,235" class="mp-lot-poly is-sold" data-lot-id="C-21" />
                  <text x="634" y="198" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">C21</text>

                  <polygon points="187,240 222,244 218,323 183,319" class="mp-lot-poly" data-lot-id="D-05" />
                  <text x="202" y="284" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">D05</text>

                  <polygon points="560,284 600,289 596,371 556,366" class="mp-lot-poly" data-lot-id="E-12" />
                  <text x="578" y="331" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">E12</text>

                  <polygon points="774,188 811,192 807,281 770,277" class="mp-lot-poly" data-lot-id="F-03" />
                  <text x="790" y="237" font-size="10" font-family="'JetBrains Mono', monospace" font-weight="700" fill="#fff" text-anchor="middle" pointer-events="none">F03</text>
                </svg>
              </div>

              <!-- Filtros Inferiores -->
              <div class="mp-bottom-bar inmo-mono">
                <button class="mp-filter-btn active" data-filter="all">Todos los lotes</button>
                <button class="mp-filter-btn" data-filter="disponible">Solo Disponibles</button>
                <button class="mp-filter-btn" data-filter="vista">Frente al Parque</button>
                <button class="mp-filter-btn" data-filter="esquina">Lotes Esquina</button>
              </div>
            </div>

            <!-- Infraestructura & Servicios del Proyecto (Amenities) -->
            <div class="mp-amenities-bar" aria-label="Infraestructura y equipamiento del desarrollo">
              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-water" title="Agua potable y red de desagüe">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="5" x2="3" y2="9" />
                    <path d="M3 7h5a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h5" />
                    <line x1="8" y1="5" x2="8" y2="9" />
                    <line x1="14" y1="13" x2="14" y2="17" />
                    <line x1="19" y1="13" x2="19" y2="17" />
                  </svg>
                </div>
                <span>Agua y desagüe</span>
              </div>

              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-drainage" title="Drenaje pluvial">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="3" />
                    <circle cx="12" cy="12" r="5" />
                    <line x1="12" y1="3" x2="12" y2="7" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                    <line x1="3" y1="12" x2="7" y2="12" />
                    <line x1="17" y1="12" x2="21" y2="12" />
                  </svg>
                </div>
                <span>Calle con drenajes</span>
              </div>

              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-play" title="Áreas recreativas y juegos infantiles">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 9l5-5 5 5" />
                    <path d="M6 9v11" />
                    <path d="M14 9v11" />
                    <line x1="6" y1="13" x2="14" y2="13" />
                    <line x1="6" y1="17" x2="14" y2="17" />
                    <path d="M14 11c3 0 4 3 4 5s1 4 3 4" />
                  </svg>
                </div>
                <span>Juegos infantiles</span>
              </div>

              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-gate" title="Pórtico de acceso y seguridad">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v15" />
                    <path d="M17 20V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v15" />
                    <line x1="7" y1="9" x2="17" y2="9" />
                    <line x1="7" y1="16" x2="17" y2="16" />
                    <line x1="10" y1="6" x2="10" y2="18" />
                    <line x1="12" y1="4" x2="12" y2="18" />
                    <line x1="14" y1="6" x2="14" y2="18" />
                  </svg>
                </div>
                <span>Pórtico de Ingreso</span>
              </div>

              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-roads" title="Vías asfaltadas y veredas">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="6" width="18" height="12" rx="2" />
                    <line x1="3" y1="9" x2="21" y2="9" stroke-dasharray="1 1" />
                    <line x1="3" y1="15" x2="21" y2="15" stroke-dasharray="1 1" />
                    <line x1="6" y1="12" x2="9" y2="12" />
                    <line x1="11" y1="12" x2="14" y2="12" />
                    <line x1="16" y1="12" x2="19" y2="12" />
                  </svg>
                </div>
                <span>Vías y veredas</span>
              </div>

              <div class="mp-amenities-item">
                <div class="mp-amenity-icon is-nature" title="Áreas verdes y paisajismo">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0-5.5 3.6A5 5 0 0 0 7 16h10a5 5 0 0 0 .5-9.4A6 6 0 0 0 12 3z" />
                    <line x1="12" y1="16" x2="12" y2="21" />
                    <line x1="5" y1="21" x2="19" y2="21" />
                  </svg>
                </div>
                <span>Áreas verdes</span>
              </div>
            </div>
          </div>

          <!-- Ficha Técnica Lateral Limpia -->
          <div class="mp-inspector">
            <div style="display:flex; justify-content:space-between; align-items:baseline;">
              <div>
                <span class="clean-kicker" style="margin-bottom:2px; font-size:10px;">LOTE SELECCIONADO</span>
                <h3 class="inmo-display" id="lot-title" style="font-size:22px; margin:0; color:var(--inmo-ink);">Lote A-14</h3>
              </div>
              <span class="badge-clean-status disponible" id="lot-status">Disponible</span>
            </div>

            <p style="font-size:13px; color:var(--inmo-ink-secondary); margin:0;" id="lot-desc">
              Ubicación privilegiada frente al parque central y cerca del ingreso principal.
            </p>

            <div class="spec-grid-clean">
              <div class="spec-box-clean">
                <div class="spec-box-clean-label">Área de Terreno</div>
