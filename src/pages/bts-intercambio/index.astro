  { id: 2, seller: "Luz de Army", initials: "LA", verified: true, zone: "Tribuna Oriente", side: "Sector O-14 · fila 8", date: "Vie · 09 oct", price: 720, qty: 2, color: "violet", note: "Juntas · pago coordinado" },
  { id: 3, seller: "Nico P.", initials: "NP", verified: false, zone: "Tribuna Norte", side: "Sector N-05 · fila 12", date: "Sáb · 10 oct", price: 520, qty: 1, color: "lilac", note: "QR listo para transferir" },
  { id: 4, seller: "Sofi Kim", initials: "SK", verified: true, zone: "Tribuna Occidente", side: "Sector O-02 · fila 4", date: "Mié · 07 oct", price: 680, qty: 2, color: "violet", note: "Vendo las 2 juntas · trato seguro" },
  { id: 5, seller: "Valentina A.", initials: "VA", verified: true, zone: "Campo", side: "Acceso general", date: "Sáb · 10 oct", price: 900, qty: 1, color: "pink", note: "Incluye prueba de compra" },
