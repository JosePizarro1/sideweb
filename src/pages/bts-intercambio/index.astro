---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Intercambia entradas para BTS World Tour Arirang en Lima." />
    <title>ARMY Exchange · Lima 2026</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <nav class="topbar">
        <a class="brand" href="#inicio" aria-label="Army Exchange inicio"><span class="brand-mark">✦</span><span>ARMY<small>EXCHANGE</small></span></a>
        <div class="nav-links"><a href="#entradas">Entradas</a><a href="#mapa">Mapa de zonas</a><a href="#seguridad">Cómo funciona</a></div>
        <div class="nav-actions"><button class="ghost-btn" data-open="login">Iniciar sesión</button><button class="pill-btn" data-open="publish">Publicar entrada <span>＋</span></button></div>
      </nav>

      <section class="hero" id="inicio">
        <div class="hero-bg"></div><div class="hero-noise"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span class="live-dot"></span>Intercambio entre fans · Lima, Perú</p>
          <h1>Nos vemos<br /><em>en San Marcos.</em></h1>
          <p class="hero-text">Encuentra o publica tu entrada para vivir el <strong>BTS WORLD TOUR ‘ARIRANG’</strong> junto a la comunidad ARMY.</p>
          <div class="hero-cta"><a class="lime-btn" href="#entradas">Ver entradas disponibles <span>↗</span></a><button class="text-btn" data-open="publish">Quiero publicar <span>→</span></button></div>
        </div>
        <div class="hero-event-card"><p>Próxima fecha</p><strong>MIÉ 07 <i>OCT</i></strong><span>Estadio San Marcos · Lima</span><div class="mini-count"><b id="hero-days">30</b><small>días para el show</small></div></div>
        <div class="hero-bottom"><span>01 — 03</span><span>scroll para explorar</span><span>ARIRANG / LIMA 2026</span></div>
      </section>

      <section class="event-strip"><div><span class="label">BTS WORLD TOUR</span><strong>‘ARIRANG’</strong></div><div><span class="label">ESTADIO SAN MARCOS</span><strong>LIMA, PERÚ</strong></div><div><span class="label">FECHAS</span><strong>07 · 09 · 10 OCT 2026</strong></div><div><span class="label">TRANSFERENCIAS</span><strong>SE ACTIVAN EL LUNES <i>✦</i></strong></div></section>

      <section class="transfer-banner"><div><p class="eyebrow purple">Apertura de transferencias</p><h2>El lunes 07<br /><em>se activa todo.</em></h2></div><div class="transfer-clock"><span>FALTAN</span><div><b id="transfer-days">00</b><small>días</small></div><i>:</i><div><b id="transfer-hours">00</b><small>horas</small></div><i>:</i><div><b id="transfer-minutes">00</b><small>min</small></div><i>:</i><div><b id="transfer-seconds">00</b><small>seg</small></div><p>Transferencia de entradas disponible<br />a partir del lunes 7 de septiembre.</p></div></section>

      <section class="visual-strip"><div class="visual-copy"><p class="eyebrow purple">La experiencia ARMY</p><h2>Una noche<br /><em>para recordar.</em></h2><p>Encuentra tu lugar, conecta con alguien de la comunidad y lleguen al show con todo listo.</p></div><div class="visual-tile visual-one"><span>01 / LIMA</span></div><div class="visual-tile visual-two"><span>02 / ARIRANG</span></div></section>

      <section class="countdown-section">
        <div><p class="eyebrow purple">La cuenta regresiva</p><h2>El momento<br /><em>se acerca.</em></h2></div>
        <div class="countdown" aria-label="Cuenta regresiva para el concierto"><div><b id="days">30</b><span>días</span></div><i>:</i><div><b id="hours">18</b><span>horas</span></div><i>:</i><div><b id="minutes">42</b><span>min</span></div><i>:</i><div><b id="seconds">08</b><span>seg</span></div></div>
        <p class="muted">Miércoles 7 de octubre de 2026 · 20:00 h<br />La cuenta se actualiza en tiempo real.</p>
      </section>

      <section class="listings-section" id="entradas">
        <div class="section-heading"><div><p class="eyebrow purple">Intercambio activo</p><h2>Entradas de la<br /><em>comunidad.</em></h2></div><p class="section-intro">Publicaciones de fans verificados y entradas con comprobante. Elige tu fecha, zona y encuentra tu lugar.</p></div>
        <div class="date-tabs" role="tablist">{dates.map((date, index) => <button class:list-active={index === 0} data-date={date.day} role="tab"><span>{date.label}</span><b>{date.day}</b><small>{date.month} · {date.count} disponibles</small></button>)}</div>
        <div class="toolbar"><div class="result-count"><strong id="result-count">24</strong> entradas encontradas</div><div class="filters"><button class="filter-select" data-filter="zone">Todas las zonas <span>⌄</span></button><button class="filter-select" data-filter="sort">Más recientes <span>⌄</span></button></div></div>
        <div class="listing-grid" id="listing-grid">{listings.map((item) => <article class="ticket-card" data-date={item.date.includes("07") ? "07" : item.date.includes("09") ? "09" : "10"} data-zone={item.zone}>
          <div class="card-top"><span class={`seat-dot ${item.color}`}></span><span>{item.zone}</span><button class="heart" aria-label={`Guardar entrada de ${item.seller}`} data-heart="false">♡</button></div>
          <div class="ticket-main"><div><p class="ticket-side">{item.side}</p><h3>S/ {item.price.toLocaleString("es-PE")}</h3><p class="ticket-note">{item.note}</p></div><div class="quantity"><b>{item.qty}</b><span>{item.qty === 1 ? "entrada" : "entradas"}</span></div></div>
          <div class="card-footer"><div class="seller"><span class={`avatar ${item.color}`}>{item.initials}</span><span><b>{item.seller}</b><small>{item.verified && <i>✓</i>} {item.verified ? "Identidad verificada" : "Usuario nuevo"}</small></span></div><button class="contact-btn" data-seller={item.seller} data-zone={item.zone} data-price={item.price}>Contactar <span>↗</span></button></div>
        </article>)}</div>
        <div class="empty-state" id="empty-state" hidden>No hay entradas para esta combinación todavía.<button data-open="publish">Publicar una entrada</button></div>
      </section>

      <section class="map-section" id="mapa"><div class="section-heading"><div><p class="eyebrow purple">Conoce tu lugar</p><h2>Mapa de<br /><em>zonas.</em></h2></div><p class="section-intro">Explora las zonas del Estadio San Marcos y luego revisa los precios publicados por cada persona que revende.</p></div>
        <div class="map-layout"><div class="stadium-map" aria-label="Mapa referencial de zonas del estadio"><img src="/bts-intercambio/mapa-zonas-polished.png" alt="Mapa referencial de zonas del Estadio San Marcos" /></div><div class="map-legend"><p class="eyebrow purple">Mapa referencial</p>{[{name:"Campo", color:"pink", note:"Frente al escenario"},{name:"Tribuna Oriente / Occidente", color:"violet", note:"Vista lateral"},{name:"Tribuna Norte / Sur", color:"lilac", note:"Consulta publicaciones"}].map((row) => <div class="legend-row"><i class={`seat-dot ${row.color}`}></i><span><b>{row.name}</b><small>{row.note}</small></span><span>•</span></div>)}<div class="map-note"><span>✦</span><p>Los precios no están fijados aquí: cada persona que revende publica su propio precio y condiciones.</p></div></div></div>
      </section>

      <section class="safety-section" id="seguridad"><div class="safety-copy"><p class="eyebrow">Intercambio con confianza</p><h2>Tu entrada.<br /><em>Tu tranquilidad.</em></h2><p>ARMY Exchange conecta a fans. Nosotros ponemos las señales para que puedas tomar una decisión informada antes de contactar.</p><button class="outline-light" data-open="publish">Publicar de forma segura <span>↗</span></button></div><div class="safety-steps"><div><span>01</span><h3>Publica con claridad</h3><p>Zona, fecha, precio y comprobante. Todo visible desde el inicio.</p></div><div><span>02</span><h3>Revisa el perfil</h3><p>La insignia ✓ indica que la comunidad verificó su identidad.</p></div><div><span>03</span><h3>Habla por el canal</h3><p>Coordina los detalles y reporta cualquier comportamiento extraño.</p></div></div></section>

      <footer><a class="brand" href="#inicio"><span class="brand-mark">✦</span><span>ARMY<small>EXCHANGE</small></span></a><p>Una demo de intercambio fan-to-fan · Lima 2026</p><span>Hecho para ARMY 💜</span></footer>
    </main>

    <dialog id="contact-modal"><button class="dialog-close" data-close>×</button><p class="eyebrow purple">Contacto directo</p><h2>Escribe a <em id="modal-seller">la persona</em>.</h2><p id="modal-copy" class="muted">Coordina los detalles de tu entrada de forma clara.</p><div class="modal-ticket"><span id="modal-zone">Campo</span><strong id="modal-price">S/ 851</strong></div><textarea placeholder="Hola, me interesa tu entrada. ¿Sigue disponible?"></textarea><button class="lime-btn full" data-success>Enviar mensaje <span>↗</span></button><small class="modal-disclaimer">Demo: el mensaje no se envía todavía.</small></dialog>
    <dialog id="publish-modal"><button class="dialog-close" data-close>×</button><p class="eyebrow purple">Publica tu entrada</p><h2>Haz que otra ARMY<br /><em>llegue contigo.</em></h2><div class="form-grid"><label>Tu nombre<input placeholder="Ej. Majo R." /></label><label>WhatsApp<input placeholder="+51 999 999 999" /></label><label>Fecha<select><option>Miércoles 07 oct</option><option>Viernes 09 oct</option><option>Sábado 10 oct</option></select></label><label>Zona<select><option>Campo</option><option>Tribuna Oriente</option><option>Tribuna Occidente</option><option>Tribuna Norte</option><option>Tribuna Sur</option></select></label><label>Precio<input type="number" placeholder="851" /></label><label>Cantidad<input type="number" min="1" value="1" /></label></div><label class="upload">＋ Adjuntar comprobante <input type="file" /></label><button class="lime-btn full" data-publish-success>Revisar publicación <span>↗</span></button><small class="modal-disclaimer">Demo: tu publicación se guardaría al conectar una base de datos.</small></dialog>
    <dialog id="login-modal"><button class="dialog-close" data-close>×</button><p class="eyebrow purple">Tu espacio ARMY</p><h2>Vuelve a tu<br /><em>intercambio.</em></h2><label>Correo electrónico<input type="email" placeholder="tu@email.com" /></label><label>Contraseña<input type="password" placeholder="••••••••" /></label><button class="lime-btn full" data-login-success>Iniciar sesión <span>↗</span></button><small class="modal-disclaimer">Demo: autenticación lista para conectar.</small></dialog>

    <script is:inline>
      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => [...document.querySelectorAll(selector)];
      const modals = { contact: $("#contact-modal"), publish: $("#publish-modal"), login: $("#login-modal") };
      $$('[data-open]').forEach((button) => button.addEventListener('click', () => modals[button.dataset.open].showModal()));
      $$('[data-close]').forEach((button) => button.addEventListener('click', () => button.closest('dialog').close()));
      $$('[data-success], [data-publish-success], [data-login-success]').forEach((button) => button.addEventListener('click', () => { button.textContent = '¡Listo! ✦'; setTimeout(() => button.closest('dialog').close(), 900); }));
      $$('[data-heart]').forEach((button) => button.addEventListener('click', () => { const active = button.dataset.heart === 'true'; button.dataset.heart = String(!active); button.textContent = active ? '♡' : '♥'; }));
      $$('.contact-btn').forEach((button) => button.addEventListener('click', () => { $('#modal-seller').textContent = button.dataset.seller; $('#modal-zone').textContent = button.dataset.zone; $('#modal-price').textContent = `S/ ${Number(button.dataset.price).toLocaleString('es-PE')}`; modals.contact.showModal(); }));
      $$('.date-tabs button').forEach((tab) => tab.addEventListener('click', () => { $$('.date-tabs button').forEach((t) => t.classList.remove('list-active')); tab.classList.add('list-active'); const selected = tab.dataset.date; let visible = 0; $$('.ticket-card').forEach((card) => { const show = card.dataset.date === selected; card.hidden = !show; if (show) visible++; }); $('#result-count').textContent = tab.querySelector('small').textContent.match(/\d+/)?.[0] || visible; $('#empty-state').hidden = visible !== 0; }));
      let selectedZone = 'Todas las zonas'; let newestFirst = true;
      function applyFilters() { const activeDate = $('.date-tabs .list-active')?.dataset.date || '07'; let visible = 0; $$('.ticket-card').forEach((card) => { const dateMatch = card.dataset.date === activeDate; const zoneMatch = selectedZone === 'Todas las zonas' || card.dataset.zone === selectedZone || (selectedZone === 'Tribuna Oriente' && card.dataset.zone === 'Tribuna Occidente') || (selectedZone === 'Tribuna Norte' && card.dataset.zone === 'Tribuna Sur'); card.hidden = !(dateMatch && zoneMatch); if (!card.hidden) visible++; }); $('#result-count').textContent = visible; $('#empty-state').hidden = visible !== 0; }
      const zoneOptions = ['Todas las zonas','Campo','Tribuna Oriente','Tribuna Norte']; let zoneIndex = 0; const zoneFilter = $('.filter-select[data-filter="zone"]'); zoneFilter.addEventListener('click', () => { zoneIndex = (zoneIndex + 1) % zoneOptions.length; selectedZone = zoneOptions[zoneIndex]; zoneFilter.firstChild.textContent = selectedZone + ' '; applyFilters(); });
      const sortFilter = $('.filter-select[data-filter="sort"]'); sortFilter.addEventListener('click', () => { newestFirst = !newestFirst; const grid = $('#listing-grid'); [...grid.children].sort((a,b) => newestFirst ? Number(a.dataset.date) - Number(b.dataset.date) : Number(b.querySelector('h3').textContent.replace(/\D/g,'')) - Number(a.querySelector('h3').textContent.replace(/\D/g,''))).forEach((card) => grid.appendChild(card)); sortFilter.firstChild.textContent = newestFirst ? 'Más recientes ' : 'Precio más bajo '; });
      $$('.date-tabs button').forEach((tab) => tab.addEventListener('click', () => setTimeout(applyFilters, 0)));
      const target = new Date('2026-10-07T20:00:00-05:00'); const transferTarget = new Date('2026-09-07T09:00:00-05:00');
      function tick() { let seconds = Math.max(0, Math.floor((target - new Date()) / 1000)); const days = Math.floor(seconds / 86400); seconds %= 86400; const hours = Math.floor(seconds / 3600); seconds %= 3600; const mins = Math.floor(seconds / 60); const secs = seconds % 60; $('#days').textContent = String(days).padStart(2,'0'); $('#hero-days').textContent = days; $('#hours').textContent = String(hours).padStart(2,'0'); $('#minutes').textContent = String(mins).padStart(2,'0'); $('#seconds').textContent = String(secs).padStart(2,'0'); let transferSeconds = Math.max(0, Math.floor((transferTarget - new Date()) / 1000)); const transferDays = Math.floor(transferSeconds / 86400); transferSeconds %= 86400; const transferHours = Math.floor(transferSeconds / 3600); transferSeconds %= 3600; const transferMinutes = Math.floor(transferSeconds / 60); const transferSecs = transferSeconds % 60; $('#transfer-days').textContent = String(transferDays).padStart(2,'0'); $('#transfer-hours').textContent = String(transferHours).padStart(2,'0'); $('#transfer-minutes').textContent = String(transferMinutes).padStart(2,'0'); $('#transfer-seconds').textContent = String(transferSecs).padStart(2,'0'); }
      tick(); setInterval(tick, 1000);
    </script>
  </body>
</html>

<style>
:root{--ink:#12111a;--purple:#6d38d6;--violet:#9d6aff;--lav:#e9e0ff;--lime:#c8ef45;--paper:#fbfafc;--muted:#74727f;--line:#e3dfe9;--pink:#f5608d}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}button,a{font:inherit;color:inherit}button{cursor:pointer}a{text-decoration:none}.topbar{height:78px;padding:0 5.5vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(251,250,252,.92);position:sticky;top:0;z-index:20;backdrop-filter:blur(16px)}.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.05em;font-size:17px}.brand small{display:block;font-size:7px;letter-spacing:.2em;color:var(--purple);margin-top:-2px}.brand-mark{width:29px;height:29px;border-radius:50%;display:grid;place-items:center;background:var(--purple);color:white;font-size:15px}.nav-links{display:flex;gap:33px;font-size:12px;font-weight:700}.nav-links a:hover{color:var(--purple)}.nav-actions{display:flex;gap:10px;align-items:center}.ghost-btn,.pill-btn,.text-btn{border:0;background:none;font-size:12px;font-weight:700;padding:11px 13px}.pill-btn{background:var(--ink);color:white;border-radius:99px;padding:12px 16px}.pill-btn span{color:var(--lime);font-size:15px;margin-left:5px}.hero{min-height:650px;position:relative;overflow:hidden;color:white;display:flex;align-items:center;padding:90px 10vw}.hero-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,6,18,.92) 0%,rgba(19,10,43,.75) 44%,rgba(27,12,59,.28)),url('/bts-intercambio/hero-stadium.png') center/cover}.hero-noise{position:absolute;inset:0;background:radial-gradient(circle at 20% 18%,rgba(195,159,255,.28),transparent 25%),linear-gradient(130deg,transparent 45%,rgba(198,240,69,.16),transparent 46%);mix-blend-mode:screen}.hero-copy,.hero-event-card,.hero-bottom{position:relative;z-index:1}.hero-copy{max-width:650px}.eyebrow{text-transform:uppercase;letter