      .page{min-height:100vh;padding:18px}.hero{position:relative;min-height:calc(100vh - 36px);overflow:hidden;background:#111;color:#fff}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.04) 72%),linear-gradient(0deg,rgba(0,0,0,.5),transparent 42%);pointer-events:none}.hero-photo{position:absolute;inset:0}.hero-photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}.topbar{position:absolute;z-index:2;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:31px 38px;color:#fff}.logo{font:400 30px/.75 Georgia,serif;letter-spacing:-1.7px}.logo small{display:block;margin-top:8px;text-align:center;font:400 7px/1 Arial,sans-serif;letter-spacing:3px}.nav{display:flex;align-items:center;gap:30px;font-size:10px;letter-spacing:1.7px;text-transform:uppercase}.nav a{transition:opacity .2s}.nav a:hover{opacity:.6}.nav .menu{padding:12px 17px;border:1px solid rgba(255,255,255,.8)}.hero-copy{position:absolute;z-index:2;left:8%;bottom:11%;max-width:560px}.kicker{margin:0 0 27px;font-size:11px;letter-spacing:2.4px;text-transform:uppercase}.hero h1{margin:0;font:400 clamp(5.4rem,12vw,12rem)/.76 "Times New Roman",Georgia,serif;letter-spacing:-.095em}.hero h1 em{font-style:italic}.hero-sub{max-width:260px;margin:32px 0 26px;font-size:14px;line-height:1.45}.actions{display:flex;align-items:center;gap:24px}.button{font-size:10px;letter-spacing:1.5px;text-transform:uppercase}.button-primary{padding:14px 19px;background:#fff;color:#111}.button-link{border-bottom:1px solid #fff;padding-bottom:4px}.hero-caption{position:absolute;z-index:2;right:38px;bottom:34px;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;writing-mode:vertical-rl;transform:rotate(180deg)}
      .below{max-width:1250px;margin:0 auto;padding:115px 7vw 54px}.intro{display:grid;grid-template-columns:1fr 2fr;gap:80px;border-top:1px solid #111;padding-top:25px}.label{font-size:10px;letter-spacing:2px;text-transform:uppercase}.intro h2{max-width:850px;margin:0;font:400 clamp(3.2rem,7vw,8rem)/.82 "Times New Roman",Georgia,serif;letter-spacing:-.08em}.intro h2 em{font-style:italic}.visit{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:105px}.visit-block{min-height:240px;padding:28px;border-top:1px solid #111;border-bottom:1px solid #111}.visit-block.dark{background:#111;color:#fff;border-color:#111}.visit-label{font-size:10px;letter-spacing:2px;text-transform:uppercase}.visit-title{margin:48px 0 13px;font:400 28px/1 Georgia,serif;letter-spacing:-1px}.visit-copy{max-width:330px;margin:0;color:#666;font-size:13px;line-height:1.55}.dark .visit-copy{color:#d5d5d5}.visit-actions{display:flex;gap:20px;flex-wrap:wrap;margin-top:22px}.visit-actions a{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:4px}.footer{display:flex;justify-content:space-between;gap:30px;margin-top:86px;font-size:10px;text-transform:uppercase;letter-spacing:1.5px}.footer a{border-bottom:1px solid #111;padding-bottom:3px}
