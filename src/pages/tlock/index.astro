    note: "Suave, frutal y con una sorpresa en el centro.",
    tag: "TLOC original",
  },
  {
    image: "/tlock/tloc-classic.webp",
    name: "La clásica",
    note: "Doradita por fuera, suave por dentro y cargada de chocolate.",
    tag: "Favorita",
  },
  {
    image: "/tlock/tloc-full-chocolate-v2.webp",
