---
import "../styles/global.css";

const featured = [
  {
    number: "01",
    category: "Landing page · Fitness",
    name: "Focus Club Fitness",
    description: "Una experiencia intensa y directa para presentar el gimnasio, sus productos y convertir visitas en nuevos miembros.",
    image: "/projects/focus.jpg",
    href: "/focus",
    accent: "yellow",
  },
  {
    number: "02",
    category: "Landing page · Gastronomía",
    name: "TLOC Cookies",
    description: "Identidad divertida, producto protagonista y un recorrido sencillo que termina directamente en el pedido por WhatsApp.",
    image: "/projects/tloc.jpg",
    href: "/tlock",
    accent: "blue",
  },
];

const archive = [
  { name: "Proyecto e-commerce", tag: "E-commerce", image: "/projects/ecommerce.webp" },
  { name: "Estudio de producción", tag: "Web corporativa", image: "/projects/produccion.webp" },
  { name: "Catálogo industrial", tag: "Catálogo digital", image: "/projects/industrial.webp" },
  { name: "Telecomunicaciones", tag: "Landing comercial", image: "/projects/telecom.webp" },
  { name: "Catálogo retail", tag: "E-commerce", image: "/projects/retail.webp" },
  { name: "Panel de control", tag: "UI / Dashboard", image: "/projects/dashboard.webp" },
];

const arrowPath = "M4 10h11M11 5l5 5-5 5";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portafolio de Jose Pizarro: landing pages, páginas corporativas, sistemas web y soluciones digitales." />
    <meta property="og:title" content="Jose Pizarro — Diseño web & sistemas" />
    <meta property="og:description" content="Landing pages, sistemas web y experiencias digitales que funcionan de verdad." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jose Pizarro — Diseño web & sistemas" />
    <meta name="twitter:description" content="Landing pages, sistemas web y experiencias digitales." />
    <meta name="twitter:image" content="/og.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Jose Pizarro — Diseño web & sistemas</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a class="wordmark" href="#inicio" aria-label="Jose Pizarro, inicio"><span>JP</span><b>Jose Pizarro</b></a>
        <nav aria-label="Navegación principal"><a href="#proyectos">Proyectos</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav>
        <a class="availability" href="#contacto"><i></i> Disponible para proyectos <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath}></path></svg></a>
      </header>

      <section class="hero" id="inicio">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-topline"><span>Diseño & desarrollo web</span></div>
        <div class="hero-main">
          <h1 aria-label="Páginas que se ven profesionales y funcionan de verdad.">Páginas que<br />se ven <span class="rotating-shell"><span class="rotating-word" aria-hidden="true">profesionales</span></span><br />y funcionan de verdad.</h1>
          <div class="hero-aside">
            <div class="hero-mascot" aria-label="Jota, la mascota digital de Jose Pizarro">
              <span class="mascot-orbit" aria-hidden="true"></span>
              <img src="/brand/jota-mascot.png" alt="Jota, una mascota azul con forma de letra J que señala el titular" />
            </div>
            <div class="hero-aside-copy">
              <p>Diseño landings y sistemas con una idea clara: hacer que cada negocio se vea mejor y trabaje más fácil.</p>
              <a class="primary-button" href="#proyectos">Explorar proyectos <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath}></path></svg></a>
            </div>
          </div>
        </div>
        <div class="hero-bottom">
          <div class="hero-number">01<span>/02</span></div>
          <p>Landing pages · Sistemas web<br />UI/UX · Automatización</p>
          <div class="scroll-note"><span>↓</span> Desliza para ver mi trabajo</div>
        </div>
      </section>

      <div class="ticker" aria-label="Especialidades"><span>LANDING PAGES</span><b>✦</b><span>SISTEMAS WEB</span><b>✦</b><span>UI / UX</span><b>✦</b><span>AUTOMATIZACIÓN</span><b>✦</b></div>

      <section class="work section" id="proyectos">
        <div class="section-head">
          <div><p class="kicker">Proyectos seleccionados</p><h2>Trabajo real.<br />Resultados visibles.</h2></div>
          <p class="section-intro">Cada proyecto tiene una identidad distinta porque cada negocio también la tiene. Estas son dos experiencias creadas para marcas reales.</p>
        </div>

        <div class="featured-grid">
          {featured.map((project) => (
            <article class:list={["case-card", project.accent]}>
              <a class="case-image" href={project.href} aria-label={`Abrir ${project.name}`}>
                <img src={project.image} alt={`Captura real del proyecto ${project.name}`} loading="lazy" />
                <span class="case-number">{project.number}</span>
                <span class="live-pill"><i></i> Proyecto activo</span>
                <span class="open-circle"><svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath}></path></svg></span>
              </a>
              <div class="case-info">
                <div><p>{project.category}</p><h3>{project.name}</h3></div>
                <p>{project.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="archive section" aria-labelledby="archivo-title">
        <div class="archive-title"><p class="kicker">Más exploraciones</p><h2 id="archivo-title">Otros trabajos</h2><span>Una selección de interfaces, catálogos y páginas comerciales.</span></div>
        <div class="archive-grid">
          {archive.map((item, index) => (
            <article class="archive-card">
              <div class="archive-image"><img src={item.image} alt={`Diseño de ${item.name}`} loading="lazy" /><span>{String(index + 3).padStart(2, "0")}</span></div>
              <div><h3>{item.name}</h3><p>{item.tag}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="services section" id="servicios">
        <div class="services-heading"><p class="kicker">Cómo puedo ayudarte</p><h2>De la idea<br />a una web lista.</h2><p>Una solución completa, cuidando tanto lo que el usuario ve como lo que necesita hacer.</p></div>
        <div class="services-list">
          <article><span>01</span><div><h3>Landing pages</h3><p>Páginas enfocadas en vender, presentar un servicio o captar nuevos clientes.</p></div><b>↗</b></article>
          <article><span>02</span><div><h3>Sistemas web</h3><p>Herramientas a medida para ordenar procesos, información y tareas diarias.</p></div><b>↗</b></article>
          <article><span>03</span><div><h3>UI / UX</h3><p>Interfaces simples, coherentes y cómodas tanto en computadora como en celular.</p></div><b>↗</b></article>
          <article><span>04</span><div><h3>Automatización e IA</h3><p>Soluciones para ahorrar tiempo, responder mejor y reducir trabajo repetitivo.</p></div><b>↗</b></article>
        </div>
      </section>

      <section class="contact section" id="contacto">
        <p class="kicker">¿Tienes una idea?</p>
        <h2>Hablemos de tu<br /><em>próximo proyecto.</em></h2>
        <div class="contact-row">
          <p>Cuéntame qué necesitas y conversemos sobre la mejor forma de hacerlo realidad.</p>
          <a class="whatsapp-button" href="https://wa.me/51945770325?text=Hola%20Jose%2C%20quiero%20conversar%20sobre%20un%20proyecto" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.012 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.758.459 3.474 1.33 4.982L2 22l5.176-1.338c1.45.79 3.097 1.206 4.836 1.206h.005c5.507 0 9.99-4.478 9.99-9.984 0-2.667-1.039-5.174-2.927-7.06A9.919 9.919 0 0 0 12.012 2zm.005 1.666c2.22 0 4.309.865 5.88 2.433a8.272 8.272 0 0 1 2.436 5.869c0 4.587-3.732 8.318-8.316 8.318h-.004a8.316 8.316 0 0 1-4.223-1.156l-.303-.18-3.07.794.811-2.992-.197-.314a8.28 8.28 0 0 1-1.272-4.47c0-4.588 3.733-8.318 8.258-8.318zm-3.56 4.148c-.206 0-.539.077-.822.385-.282.308-1.077 1.053-1.077 2.567 0 1.514 1.103 2.977 1.257 3.183.154.205 2.128 3.328 5.228 4.542 2.584 1.013 2.584.676 3.047.625.462-.051 1.488-.607 1.693-1.194.205-.587.205-1.09.144-1.194-.062-.104-.231-.167-.487-.295s-1.514-.744-1.745-.828c-.231-.084-.398-.126-.564.126-.167.252-.642.809-.787.973-.145.165-.29.186-.546.058-.256-.128-1.082-.399-2.062-1.273-.762-.68-1.277-1.52-1.427-1.777-.15-.257-.016-.396.112-.524.116-.115.257-.308.385-.462.128-.154.171-.26.257-.432.085-.171.043-.321-.021-.449-.064-.128-.564-1.36-.773-1.862-.204-.49-.412-.423-.564-.431h-.482z"></path></svg>
            Escribir por WhatsApp
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath}></path></svg>
          </a>
        </div>
      </section>

      <footer>
        <a class="footer-name" href="#inicio">Jose Pizarro</a>
        <a href="mailto:jose.pizarro.tech@gmail.com">jose.pizarro.tech@gmail.com</a>
        <p>Diseño y desarrollo web · 2026</p>
      </footer>
    </main>

    <script is:inline>
      const words = ["profesionales", "amigables", "intuitivas", "modernas", "rápidas", "memorables"];
      let wordIndex = 0;

      function startRotation() {
        const rotatingWord = document.querySelector(".rotating-word");
        if (!rotatingWord) return;

        // Iniciar con la clase activa
        rotatingWord.classList.add("vhs-active");

        setInterval(() => {
          wordIndex = (wordIndex + 1) % words.length;
          rotatingWord.textContent = words[wordIndex];
          rotatingWord.classList.remove("vhs-active");
          void rotatingWord.offsetWidth; // Forzar reflow en el navegador
          rotatingWord.classList.add("vhs-active");
        }, 2200);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startRotation);
      } else {
        startRotation();
      }
    </script>
  </body>
</html>
